<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <solid android:color="#7F8C8D" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1dp" android:color="#95A5A6" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="2dp" android:top="3dp" android:right="2dp" android:bottom="1dp">
                <shape android:shape="rectangle">
                    <solid android:color="#1A000000" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
            <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="3dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <gradient
                        android:startColor="#D5DBDB"
                        android:endColor="#95A5A6"
                        android:angle="270" />
                    <stroke android:width="1.5dp" android:color="#E5E7E9" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
