<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvDisplay"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_display"
        android:gravity="end|center_vertical"
        android:paddingHorizontal="24dp"
        android:text="0"
        android:textColor="@color/display_text"
        android:textSize="72sp"
        android:fontFamily="@font/dseg7" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:columnCount="4"
        android:rowCount="5"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:useDefaultMargins="true">

        <Button
            android:id="@+id/btnClear"
            style="@style/CalcButtonFunction"
            android:text="AC" />

        <Button
            android:id="@+id/btnSign"
            style="@style/CalcButtonFunction"
            android:text="±" />

        <Button
            android:id="@+id/btnPercent"
            style="@style/CalcButtonFunction"
            android:text="%" />

        <Button
            android:id="@+id/btnDivide"
            style="@style/CalcButtonOperator"
            android:text="÷" />

        <Button
            android:id="@+id/btn7"
            style="@style/CalcButtonNumber"
            android:text="7" />

        <Button
            android:id="@+id/btn8"
            style="@style/CalcButtonNumber"
            android:text="8" />

        <Button
            android:id="@+id/btn9"
            style="@style/CalcButtonNumber"
            android:text="9" />

        <Button
            android:id="@+id/btnMultiply"
            style="@style/CalcButtonOperator"
            android:text="×" />

        <Button
            android:id="@+id/btn4"
            style="@style/CalcButtonNumber"
            android:text="4" />

        <Button
            android:id="@+id/btn5"
            style="@style/CalcButtonNumber"
            android:text="5" />

        <Button
            android:id="@+id/btn6"
            style="@style/CalcButtonNumber"
            android:text="6" />

        <Button
            android:id="@+id/btnSubtract"
            style="@style/CalcButtonOperator"
            android:text="−" />

        <Button
            android:id="@+id/btn1"
            style="@style/CalcButtonNumber"
            android:text="1" />

        <Button
            android:id="@+id/btn2"
            style="@style/CalcButtonNumber"
            android:text="2" />

        <Button
            android:id="@+id/btn3"
            style="@style/CalcButtonNumber"
            android:text="3" />

        <Button
            android:id="@+id/btnAdd"
            style="@style/CalcButtonOperator"
            android:text="+" />

        <Button
            android:id="@+id/btn0"
            style="@style/CalcButtonNumber"
            android:text="0"
            android:layout_columnSpan="2" />

        <Button
            android:id="@+id/btnDecimal"
            style="@style/CalcButtonNumber"
            android:text="." />

        <Button
            android:id="@+id/btnEquals"
            style="@style/CalcButtonEquals"
            android:text="=" />

    </GridLayout>

</LinearLayout>
