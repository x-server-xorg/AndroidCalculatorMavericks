<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="btn_eq_border">#F39C12</color>
    <color name="btn_equals_end">#D35400</color>
    <color name="btn_equals_start">#E67E22</color>
    <color name="btn_function_border">#D5DBDB</color>
    <color name="btn_function_end">#95A5A6</color>
    <color name="btn_function_pressed">#7F8C8D</color>
    <color name="btn_function_start">#BDC3C7</color>
    <color name="btn_number_border">#7A7A7A</color>
    <color name="btn_number_end">#3A3A3A</color>
    <color name="btn_number_pressed">#2A2A2A</color>
    <color name="btn_number_start">#6B6B6B</color>
    <color name="btn_operator_border">#F39C12</color>
    <color name="btn_operator_end">#D35400</color>
    <color name="btn_operator_pressed">#B34700</color>
    <color name="btn_operator_start">#E67E22</color>
    <color name="btn_text_dark">#2C3E50</color>
    <color name="btn_text_white">#FFFFFF</color>
    <color name="display_bezel">#1A1A1A</color>
    <color name="display_bg">#0A1A0A</color>
    <color name="display_text">#33FF33</color>
    <color name="leather_dark">#1A0F0A</color>
    <color name="leather_light">#2C1810</color>
    <color name="leather_mid">#3D2317</color>
    <color name="shadow_color">#1A000000</color>
    <string name="app_name">Calculator</string>
    <style name="CalcButtonBase">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_margin">3dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:shadowColor">#80000000</item>
        <item name="android:shadowDx">0</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="CalcButtonEquals" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_equals</item>
        <item name="android:textColor">@color/btn_text_white</item>
    </style>
    <style name="CalcButtonFunction" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_function</item>
        <item name="android:textColor">@color/btn_text_dark</item>
    </style>
    <style name="CalcButtonNumber" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_number</item>
        <item name="android:textColor">@color/btn_text_white</item>
    </style>
    <style name="CalcButtonOperator" parent="CalcButtonBase">
        <item name="android:background">@drawable/btn_operator</item>
        <item name="android:textColor">@color/btn_text_white</item>
    </style>
    <style name="Theme.CalcMavericks" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_main</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">#0D0705</item>
    </style>
</resources>